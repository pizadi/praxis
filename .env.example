# ===== Clinic MS — local development / Pi deployment =====
# Copy to .env and adjust. NEVER commit .env.

# --- Database ---
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=clinic
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Alembic / scripts connect from host to localhost:5434 (mapped port)
POSTGRES_HOST_PORT=5434

# --- API ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-new-one-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma separated list, e.g. "http://localhost:5173,http://192.168.1.10"
CORS_ORIGINS=http://localhost:5173
# Where uploaded files live (inside the api container: use a volume!)
UPLOAD_DIR=/data/uploads
# Max upload size (bytes)
MAX_UPLOAD_BYTES=52428800
# Timezone used for date-boundary queries (display tz for reports)
APP_TIMEZONE=Asia/Tehran

# --- Frontend (Vite dev) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Initial bootstrap admin ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-too
