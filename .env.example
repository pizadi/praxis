# ===== Clinic MS — local development / Pi deployment =====
# Copy to .env and adjust. NEVER commit .env.

# --- Database ---
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=clinic
# Alembic / scripts connect from host to localhost:5434 (mapped port,
# bound to 127.0.0.1 — not reachable from the LAN)
POSTGRES_HOST_PORT=5434

# --- API ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-new-one-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set true when nginx is served over HTTPS. The default LAN deployment is HTTP.
SESSION_COOKIE_SECURE=false
# Login lockout: after this many failed logins for one username within the
# window, the account refuses logins (429) until the window clears
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Comma separated list, e.g. "http://localhost:5173,http://192.168.1.10"
CORS_ORIGINS=http://localhost:5173
# Where uploaded files live (inside the api container: use a volume!)
UPLOAD_DIR=/data/uploads
# Max upload size (bytes)
MAX_UPLOAD_BYTES=52428800
# Backup tarball encryption passphrase (AES-256-GCM). Empty = unencrypted
# tarballs. SETTING a key also unlocks importing encrypted backups; losing
# it means losing the backups — store it in a password manager.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_ENCRYPTION_KEY=
# Stale-backup warning for admins: when the last successful backup is older
# than this many days, a banner appears (0 disables the warning)
BACKUP_STALE_DAYS=7
# Timezone used for date-boundary queries (display tz for reports)
APP_TIMEZONE=Asia/Tehran
# Set to "production" to make the API refuse insecure defaults
# (dev SECRET_KEY / default admin password) at startup.
# The compose stack sets this automatically.
CLINIC_ENV=
# Host port the compose api service binds to (127.0.0.1 only).
# Change when another service on this machine already holds 8000.
API_HOST_PORT=8000

# --- Frontend (Vite dev) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Initial bootstrap admin (created only if no users exist) ---
BOOTSTRAP_ADMIN_USERNAME=admin
# Use a long passphrase — this is the most privileged account
BOOTSTRAP_ADMIN_PASSWORD=change-me-too
