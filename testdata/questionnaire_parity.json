{
  "$schema": "questionnaire-parity-corpus-v1",
  "description": "Shared conformance corpus for the questionnaire validators — consumed by backend/tests/parity/test_questionnaire_parity.py (pytest) AND frontend/src/parity/questionnaire.parity.test.ts (vitest). Both languages MUST agree on every case: the server is authoritative, the TS mirror drives the builder's live checks. Edit only together with both validators.",
  "float_rule": "both sides use IEEE754 doubles with identical operations — exact equality",
  "templates": {
    "two_numbers": {
      "version": 1,
      "title": "t",
      "questions": [
        {
          "key": "a",
          "label": "A",
          "type": "number",
          "min": 0,
          "max": 100
        },
        {
          "key": "b",
          "label": "B",
          "type": "number"
        }
      ]
    },
    "neg_number": {
      "version": 1,
      "title": "t",
      "questions": [
        {
          "key": "a",
          "label": "A",
          "type": "number",
          "min": -5,
          "max": 5
        }
      ]
    },
    "number_and_choice": {
      "version": 1,
      "title": "t",
      "questions": [
        {
          "key": "a",
          "label": "A",
          "type": "number",
          "min": 0,
          "max": 100,
          "integer": true
        },
        {
          "key": "c",
          "label": "C",
          "type": "choice",
          "options": [
            {
              "value": "lo",
              "label": "low",
              "score": 1
            },
            {
              "value": "hi",
              "label": "high",
              "score": 4
            },
            {
              "value": "none",
              "label": "none",
              "score": null
            }
          ]
        }
      ]
    },
    "choice_only": {
      "version": 1,
      "title": "t",
      "questions": [
        {
          "key": "c",
          "label": "C",
          "type": "choice",
          "options": [
            {
              "value": "bad",
              "label": "bad",
              "score": 0
            },
            {
              "value": "good",
              "label": "good",
              "score": 3
            }
          ]
        }
      ]
    },
    "named_abs": {
      "version": 1,
      "title": "t",
      "questions": [
        {
          "key": "abs",
          "label": "A",
          "type": "number",
          "min": 0,
          "max": 100
        },
        {
          "key": "b",
          "label": "B",
          "type": "number"
        }
      ]
    }
  },
  "formula_evaluation": [
    {
      "name": "single ref",
      "template": "two_numbers",
      "formula": "a",
      "answers": {
        "a": 7,
        "b": 1
      },
      "expected": 7
    },
    {
      "name": "add",
